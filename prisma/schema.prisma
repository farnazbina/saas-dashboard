generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ==============================
//  مدل‌های پایه
// ==============================

model Category {
  id        String   @id @default(cuid())
  name      String   @unique
  projects  Project[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("categories")
}

model Client {
  id        String   @id @default(cuid())
  name      String
  email     String?  @unique
  phone     String?
  company   String?
  projects  Project[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("clients")
}

// ==============================
//  مدل کاربر یکپارچه (جایگزین TeamLead)
// ==============================

enum Role {
  ADMIN
  TEAM_LEAD
  MEMBER
}

model User {
  id        String   @id @default(cuid())
  name      String
  email     String   @unique
  avatar    String?
  role      Role     @default(MEMBER)

  // پروژه‌هایی که این کاربر به عنوان تیم‌لید در آنهاست
  leadProjects Project[] @relation("TeamLeadProjects")
  // پروژه‌هایی که این کاربر به عنوان عضو معمولی در آنهاست
  memberProjects Project[] @relation("TeamMembers")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("users")
}

// ==============================
//  مدل پروژه (با ایندکس‌های بهینه)
// ==============================

enum Status {
  TODO
  IN_PROGRESS   // تغییر از In_PROGRESS به IN_PROGRESS (استاندارد)
  DONE
}

model Project {
  id          String   @id @default(cuid())
  name        String
  description String?
  status      Status   @default(TODO)

  // کلیدهای خارجی
  categoryId  String
  clientId    String
  teamLeadId  String   // ارجاع به User با نقش TEAM_LEAD
  memberId    String   // ارجاع به User با نقش MEMBER (یا هر نقش دیگر)

  // روابط
  category    Category @relation(fields: [categoryId], references: [id])
  client      Client   @relation(fields: [clientId], references: [id])
  teamLead    User     @relation("TeamLeadProjects", fields: [teamLeadId], references: [id])
  member      User     @relation("TeamMembers", fields: [memberId], references: [id])

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // ---------- ایندکس‌های بهینه ----------
  @@index([createdAt(sort: Desc)])  // برای مرتب‌سازی سریع
  @@index([categoryId])             // برای JOIN با Category
  @@index([clientId])               // برای JOIN با Client
  @@index([teamLeadId])             // برای JOIN با User (تیم‌لید)
  @@index([memberId])               // برای JOIN با User (عضو)
  @@index([status])                 // اگر بر اساس status فیلتر می‌کنید

  @@map("projects")
}